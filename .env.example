APP_NAME=Inkstone
PUBLIC_URL=http://localhost:3000
APP_PORT=3000

DATABASE_URL=postgres://inkstone:change-me@postgres:5432/inkstone
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379
ENCRYPTION_KEY=replace-with-a-long-random-secret

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=inkstone
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret
S3_FILES_BUCKET=inkstone-files
S3_BACKUPS_BUCKET=inkstone-backups

# Optional OpenAI-compatible embeddings endpoint.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

CLIENT_ASSETS_DIR=/app/dist/client
SCHEDULER_INTERVAL_MS=60000
