{
  "name": "inkstone",
  "private": true,
  "version": "0.8.0",
  "license": "LGPL-3.0-only",
  "type": "module",
  "description": "Inkstone is a self-hosted Markdown notebook for Node.js Docker Compose deployments.",
  "homepage": "https://github.com/shuaiplus/inkstone#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuaiplus/inkstone.git"
  },
  "bugs": {
    "url": "https://github.com/shuaiplus/inkstone/issues"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:node": "tsx src/server/index.ts",
    "dev:scheduler": "tsx src/server/scheduler.ts",
    "build:node": "npm run typecheck:node && vite build --mode node",
    "typecheck:node": "tsc -p tsconfig.server.json --noEmit",
    "build": "npm run build:node",
    "start:node": "tsx src/server/index.ts",
    "start:scheduler": "tsx src/server/scheduler.ts",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b",
    "typecheck:force": "tsc -b --force",
    "test:unit": "vitest run --config vitest.config.ts",
    "i18n:check": "node scripts/check-i18n.mjs",
    "comments:check": "node scripts/check-comments.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@dicebear/core": "^9.4.3",
    "@dicebear/micah": "^9.4.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/ws": "^8.18.1",
    "client-zip": "2.5.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "dotenv": "^17.2.2",
    "hono": "4.12.34",
    "idb-keyval": "^6.3.0",
    "ioredis": "^5.7.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.28.0",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.1",
    "pg": "^8.16.3",
    "prismjs": "^1.30.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.20.5",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.5",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
